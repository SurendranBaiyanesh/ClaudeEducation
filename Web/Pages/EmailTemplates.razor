@page "/email-templates"
@inject IEmailTemplateService TemplateService

<div class="email-templates-page">
    <div class="email-templates-page__header">
        <h1 class="email-templates-page__title">Email Templates</h1>
        <button type="button" class="button button--primary" @onclick="StartNew">New Template</button>
    </div>

    @if (_templates is null)
    {
        <p>Loading...</p>
    }
    else
    {
        <div class="email-templates-page__layout">
            <aside class="email-templates-page__list">
                @if (_templates.Count == 0)
                {
                    <p class="email-templates-page__empty">No templates yet. Create your first one.</p>
                }
                else
                {
                    @foreach (var template in _templates)
                    {
                        <button type="button"
                                class="email-templates-page__list-item @(template.Id == _model.Id ? "email-templates-page__list-item--active" : "")"
                                @onclick="() => SelectTemplate(template.Id)">
                            <span class="email-templates-page__list-name">@template.Name</span>
                            @if (!template.IsActive)
                            {
                                <span class="email-templates-page__list-flag">Inactive</span>
                            }
                        </button>
                    }
                }
            </aside>

            <section class="email-templates-page__editor">
                @if (!string.IsNullOrEmpty(_statusMessage))
                {
                    <div class="email-templates-page__status">@_statusMessage</div>
                }

                <EmailTemplateEditorControl Model="_model"
                                            SubmitLabel="@(_model.Id == 0 ? "Create Template" : "Save Changes")"
                                            OnSubmit="HandleSave"
                                            OnDelete="HandleDelete" />
            </section>
        </div>
    }
</div>
