@page "/"
@namespace BacklogTicketManager.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@inject BacklogTicketManager.Services.IStyleBuilder StyleBuilder
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Backlog Ticket Manager</title>
    <base href="~/" />

    <!-- All wwwroot/css/*.css files are bundled into one stylesheet by StyleBuilder. -->
    <link rel="stylesheet" href="css/bundle.css?v=@StyleBuilder.ContentHash" />
</head>
<body>
    <component type="typeof(BacklogTicketManager.App)" render-mode="ServerPrerendered" />

    <div id="blazor-error-ui">
        An unhandled error has occurred.
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>

    <script src="_framework/blazor.server.js"></script>
</body>
</html>
