<?xml version="1.0" encoding="utf-8"?>
<xs:schema id="EmailTemplatesDataSet"
           targetNamespace="http://backlogticketmanager.local/schema/EmailTemplates.xsd"
           xmlns="http://backlogticketmanager.local/schema/EmailTemplates.xsd"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:msdata="urn:schemas-microsoft-com:xml-msdata"
           elementFormDefault="qualified">
  <xs:element name="EmailTemplatesDataSet" msdata:IsDataSet="true" msdata:UseCurrentLocale="true">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="EmailTemplate">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Id" type="xs:int" minOccurs="0" />
              <xs:element name="Name" type="xs:string" minOccurs="0" />
              <xs:element name="Description" type="xs:string" minOccurs="0" />
              <xs:element name="Subject" type="xs:string" minOccurs="0" />
              <xs:element name="Body" type="xs:string" minOccurs="0" />
              <xs:element name="IsActive" type="xs:boolean" minOccurs="0" />
              <xs:element name="CreatedDate" type="xs:dateTime" minOccurs="0" />
              <xs:element name="UpdatedDate" type="xs:dateTime" minOccurs="0" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:choice>
    </xs:complexType>
    <xs:unique name="EmailTemplateKey" msdata:PrimaryKey="true">
      <xs:selector xpath=".//EmailTemplate" />
      <xs:field xpath="Id" />
    </xs:unique>
  </xs:element>
</xs:schema>
