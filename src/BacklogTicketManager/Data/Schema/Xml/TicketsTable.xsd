<?xml version="1.0" encoding="utf-8"?>
<xs:schema id="TicketsDataSet"
           targetNamespace="http://backlogticketmanager.local/schema/Tickets.xsd"
           xmlns="http://backlogticketmanager.local/schema/Tickets.xsd"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:msdata="urn:schemas-microsoft-com:xml-msdata"
           elementFormDefault="qualified">
  <xs:element name="TicketsDataSet" msdata:IsDataSet="true" msdata:UseCurrentLocale="true">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <!-- Field names below are the single source of truth for the Tickets DataTable
             columns. SQL query column aliases must match these names exactly. -->
        <xs:element name="Ticket">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Id" type="xs:int" minOccurs="0" />
              <xs:element name="Title" type="xs:string" minOccurs="0" />
              <xs:element name="Description" type="xs:string" minOccurs="0" />
              <xs:element name="Status" type="xs:int" minOccurs="0" />
              <xs:element name="Priority" type="xs:int" minOccurs="0" />
              <xs:element name="AssignedTo" type="xs:string" minOccurs="0" />
              <xs:element name="AssignedToEmail" type="xs:string" minOccurs="0" />
              <xs:element name="CreatedDate" type="xs:dateTime" minOccurs="0" />
              <xs:element name="DueDate" type="xs:dateTime" minOccurs="0" />
              <xs:element name="CompletedDate" type="xs:dateTime" minOccurs="0" nillable="true" />
              <xs:element name="LastNotifiedDate" type="xs:dateTime" minOccurs="0" nillable="true" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:choice>
    </xs:complexType>
    <xs:unique name="TicketKey" msdata:PrimaryKey="true">
      <xs:selector xpath=".//Ticket" />
      <xs:field xpath="Id" />
    </xs:unique>
  </xs:element>
</xs:schema>
